"""{{ORCHESTRATOR_NAME}} — Dayuse orchestrator (ADK). Composes A2A leaf agents.

Generated by dayuse-agentic-platform/scaffold-orchestrator. Reuses existing leaves
via RemoteA2aAgent (Agent Card URL resolved from an env variable). NEVER
reimplements a leaf's logic: it composes it.

If the signature of RemoteA2aAgent / SequentialAgent differs in the installed
ADK version, confirm via agents-cli / Context7.
"""
import os

from google.adk.agents import SequentialAgent
from google.adk.agents.remote_a2a_agent import RemoteA2aAgent
from google.adk.models.lite_llm import LiteLlm

from .identity.provider import get_identity_provider

# --- Model (LiteLLM) & pluggable identity (oidc-mtls by default). ---
MODEL = LiteLlm(model=os.environ.get("DAYUSE_MODEL", "anthropic/claude-sonnet-4-6"))
identity = get_identity_provider()

# --- REUSED A2A leaves (deployed once, shared). ---
# The URL points at the leaf's Agent Card: .../.well-known/agent-card.json.
# The orchestrator authenticates via identity.get_outbound_credentials(<leaf>).
spec_generator = RemoteA2aAgent(
    name="spec_generator",
    agent_card=os.environ["SPEC_GENERATOR_CARD_URL"],
)
coder = RemoteA2aAgent(name="coder", agent_card=os.environ["CODER_CARD_URL"])
tester = RemoteA2aAgent(name="tester", agent_card=os.environ["TESTER_CARD_URL"])
mr_writer = RemoteA2aAgent(
    name="mr_writer",
    agent_card=os.environ["MR_WRITER_CARD_URL"],
)  # writes: true => HITL required before push (see gdpr-guardrails + PreToolUse hook).

# --- Composition: "{{FLOW_LABEL}}" pipeline. ---
# Adapt the pattern (SequentialAgent / ParallelAgent / LoopAgent) to the flow.
# The write (mr_writer) is the LAST step: single HITL control point.
root_agent = SequentialAgent(
    name="{{ORCHESTRATOR_NAME}}",
    description="{{ORCHESTRATOR_DESCRIPTION}}",
    sub_agents=[spec_generator, coder, tester, mr_writer],
)
