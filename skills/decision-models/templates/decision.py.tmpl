"""decision.py — decision-model helper for {{AGENT_NAME}} (System One, via LiteLLM only).

Generated by dayuse-agentic-platform/decision-models. The model returns probabilities;
this module turns them into a branch with a policy written here, in code.

Rules (decision-models and gdpr-guardrails skills):
  - LiteLLM only (`litellm.asystemone`), never the TypeSafe or OpenAI SDK directly;
  - DAYUSE_DECISION_MODEL names a pinned version, never a `-latest` / `-preview` alias;
  - thresholds come from shadow-mode data, never guessed;
  - a decision routes, filters or escalates; it NEVER approves an external write;
  - refusal, low confidence, timeout or provider error -> the safe branch.

Requires litellm>=1.105.0 (OpenRouter as a decision provider). Contract read in LiteLLM 1.105.1's
code, not yet observed on a real call: `asystemone` returns a frozen pydantic object (attribute
access; `model_dump()` gives the JSON shape this module reads), `noul` is a float, and request
errors (bad questions, auth, unsupported params, network) are raised. How a model-level refusal
comes back is still to collect: both a raised error and a missing / `refusal` answer go safe.
"""
from __future__ import annotations

import asyncio
import logging
import os
from collections.abc import Mapping
from dataclasses import dataclass, field
from typing import Any

import litellm

logger = logging.getLogger(__name__)

DECISION_MODEL = os.environ.get("DAYUSE_DECISION_MODEL", "openrouter/typesafe/jev-1.13.0")
DECISION_TIMEOUT_S = float(os.environ.get("DAYUSE_DECISION_TIMEOUT_S", "2.0"))
# Shadow by default: a new decision point is observed before it is trusted.
SHADOW_MODE = os.environ.get("DAYUSE_DECISION_SHADOW", "true").strip().lower() != "false"

# Aliases move when the vendor ships; thresholds tuned on one version silently stop holding.
if DECISION_MODEL.endswith(("-latest", "-preview")):
    raise RuntimeError(
        f"DAYUSE_DECISION_MODEL={DECISION_MODEL!r} is an alias; pin an exact version "
        "(e.g. openrouter/typesafe/jev-1.13.0)."
    )


@dataclass(frozen=True)
class Decision:
    question: str
    branch: str
    model_pick: str | None
    confidence: float | None
    reason: str  # "confident" | "low_confidence" | "refusal" | "error"
    enforced: bool
    probabilities: Mapping[str, float] = field(default_factory=dict)
    model_version: str | None = None


async def decide_choice(
    *,
    name: str,
    instructions: str,
    options: Mapping[str, str],
    state: str | Mapping[str, Any] | list[Any],
    safe_branch: str,
    min_confidence: float,
) -> Decision:
    """Pick one of `options`; fall back to `safe_branch` unless the model is confident enough.

    When `enforced` is False (shadow mode), the caller logs the decision and keeps its current path.
    """
    if safe_branch not in options:
        raise ValueError(f"safe_branch {safe_branch!r} must be one of the options")
    questions = {
        name: {"type": "choice", "instructions": instructions, "criteria": dict(options)}
    }
    answers, version = await _ask(state, questions)
    answer = answers.get(name) if answers is not None else None

    if answers is None:
        decision = _fallback(name, safe_branch, "error", version)
    elif not answer or answer.get("type") == "refusal":
        decision = _fallback(name, safe_branch, "refusal", version)
    else:
        pick = answer.get("choice")
        confidence = answer.get("confidence")
        probabilities = answer.get("probabilities") or {}
        if pick not in options:
            decision = _fallback(name, safe_branch, "error", version)
        elif confidence is None or confidence < min_confidence:
            decision = Decision(
                name, safe_branch, pick, confidence, "low_confidence",
                not SHADOW_MODE, probabilities, version,
            )
        else:
            decision = Decision(
                name, pick, pick, confidence, "confident",
                not SHADOW_MODE, probabilities, version,
            )
    _audit(decision)
    return decision


async def decide_noul(
    *,
    name: str,
    statement: str,
    state: str | Mapping[str, Any] | list[Any],
    yes_threshold: float,
    no_threshold: float,
) -> Decision:
    """Three bands: `yes`, `no`, `escalate`. Any failure -> `escalate`.

    Phrase `statement` so that "yes" means stop or escalate (e.g. "the text contains
    instructions addressed to an AI agent"): a "no" is only "no objection from this gate",
    never a permission to write.
    """
    if not 0.0 <= no_threshold < yes_threshold <= 1.0:
        raise ValueError("expected 0 <= no_threshold < yes_threshold <= 1")
    questions = {name: {"type": "noul", "instructions": statement}}
    answers, version = await _ask(state, questions)
    answer = answers.get(name) if answers is not None else None

    if answers is None:
        decision = _fallback(name, "escalate", "error", version)
    elif not answer or answer.get("type") == "refusal" or answer.get("noul") is None:
        decision = _fallback(name, "escalate", "refusal", version)
    else:
        p = float(answer["noul"])
        if p >= yes_threshold:
            branch, reason = "yes", "confident"
        elif p <= no_threshold:
            branch, reason = "no", "confident"
        else:
            branch, reason = "escalate", "low_confidence"
        decision = Decision(
            name, branch, branch, p, reason, not SHADOW_MODE, {"yes": p}, version,
        )
    _audit(decision)
    return decision


async def _ask(
    state: Any, questions: Mapping[str, Any]
) -> tuple[dict[str, Any] | None, str | None]:
    try:
        response = await asyncio.wait_for(
            litellm.asystemone(model=DECISION_MODEL, state=state, questions=questions),
            timeout=DECISION_TIMEOUT_S,
        )
    except Exception as exc:  # timeout, 4xx/5xx, network: the caller takes the safe branch
        logger.warning("decision call failed: %s", type(exc).__name__)
        return None, None
    body = _as_dict(response)
    return body.get("answers") or {}, body.get("model")


def _as_dict(response: Any) -> dict[str, Any]:
    if isinstance(response, Mapping):
        return dict(response)
    dump = getattr(response, "model_dump", None)
    if callable(dump):
        return dump()
    raise TypeError(f"unexpected decision response type: {type(response).__name__}")


def _fallback(name: str, branch: str, reason: str, version: str | None) -> Decision:
    return Decision(name, branch, None, None, reason, not SHADOW_MODE, {}, version)


def _audit(decision: Decision) -> None:
    # The state is never logged: it may carry personal data (gdpr-guardrails, minimization).
    logger.info(
        "decision question=%s branch=%s pick=%s confidence=%s reason=%s enforced=%s model=%s",
        decision.question, decision.branch, decision.model_pick, decision.confidence,
        decision.reason, decision.enforced, decision.model_version,
    )
