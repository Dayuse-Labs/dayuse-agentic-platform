    {
      "id": "{{AGENT_NAME}}",
      "name": "{{AGENT_NAME}}",
      "description": "{{AGENT_DESCRIPTION}}",
      "tags": ["dayuse"]
    }
  ],
  "securitySchemes": {
    "dayuse-oidc": {
      "type": "openIdConnect",
      "openIdConnectUrl": "${DAYUSE_OIDC_ISSUER}/.well-known/openid-configuration"
    },
    "mtls": {
      "type": "mutualTLS"
    }
  },
  "security": [
    { "dayuse-oidc": [], "mtls": [] }
  ]
