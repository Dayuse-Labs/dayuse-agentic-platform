"""{{AGENT_NAME}} — Dayuse leaf agent (ADK + LiteLLM, portable).

Generated by dayuse-agentic-platform/scaffold-agent. The generic ADK skeleton is
delegated to agents-cli; this file applies the Dayuse defaults:
  - model ALWAYS via LiteLLM (never a hard-coded cloud SDK);
  - pluggable identity (oidc-mtls by default, no hard GCP dependency);
  - tools via MCP, at least privilege;
  - HITL on every write (see secrets/broker.py and the plugin's PreToolUse hook).
"""
import json
import os

from google.adk.agents import Agent
from google.adk.models.lite_llm import LiteLlm
from google.adk.tools.mcp_tool.mcp_toolset import MCPToolset
from google.adk.tools.mcp_tool.mcp_session_manager import StreamableHTTPConnectionParams

from .identity.provider import get_identity_provider

# --- Model layer: LiteLLM everywhere. Switching provider = changing DAYUSE_MODEL. ---
DAYUSE_MODEL = os.environ.get("DAYUSE_MODEL", "openrouter/anthropic/claude-sonnet-5.5")


def _model_kwargs(model: str) -> dict:
    """OpenRouter routing preferences, with zero data retention forced (gdpr-guardrails).

    DAYUSE_OPENROUTER_PROVIDER_PREFS (JSON object) can add keys, e.g. pin an endpoint; it
    cannot switch ZDR off. Malformed JSON fails at import: no silent fallback to a retaining
    endpoint. Only openrouter/* gets the object: a direct provider would reject or ignore it,
    and its ZDR is a contract matter (see dayuse-defaults.md).
    """
    if not model.startswith("openrouter/"):
        return {}
    prefs = json.loads(os.environ.get("DAYUSE_OPENROUTER_PROVIDER_PREFS") or "{}")
    return {"extra_body": {"provider": {**prefs, "zdr": True}}}


MODEL = LiteLlm(model=DAYUSE_MODEL, **_model_kwargs(DAYUSE_MODEL))

# --- Identity layer: pluggable, oidc-mtls by default. ---
identity = get_identity_provider()

# --- Coordination layer (tools): one MCPToolset per required business tool. ---
# Wire ONLY the MCP servers THIS agent needs here (least privilege).
# Access tokens come from the broker/Vault + environment, never hard-coded.
TOOLSETS = [
    MCPToolset(
        connection_params=StreamableHTTPConnectionParams(
            url=os.environ["{{PRIMARY_MCP_ENV}}"],  # e.g. GITLAB_MCP_URL (HTTPS)
            timeout=60,
        ),
    ),
    # Duplicate this block for each additional business MCP server.
]

INSTRUCTION = (
    "{{AGENT_INSTRUCTION}}\n\n"
    "Dayuse constraints:\n"
    "- GDPR: minimize the personal data handled and logged.\n"
    "- HITL: every write (MR, GitLab issue, Notion page/comment) requires an "
    "explicit human confirmation BEFORE execution. Present a preview, then wait.\n"
)

root_agent = Agent(
    name="{{AGENT_NAME}}",
    model=MODEL,
    description="{{AGENT_DESCRIPTION}}",
    instruction=INSTRUCTION,
    tools=TOOLSETS,
)
