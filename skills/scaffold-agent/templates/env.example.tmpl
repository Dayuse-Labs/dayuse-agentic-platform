# {{AGENT_NAME}} — environment variables. Copy to .env (DO NOT commit the .env).
# No long-lived secret here: references only. Secrets come from the broker/Vault.

# --- Model (LiteLLM; Claude by default, not coupled to the cloud) ---
DAYUSE_MODEL=anthropic/claude-sonnet-4-6
ANTHROPIC_API_KEY=

# --- Pluggable identity ---
DAYUSE_IDENTITY_PROVIDER=oidc-mtls
DAYUSE_OIDC_ISSUER=
DAYUSE_OIDC_CLIENT_ID=
# spire : SPIFFE_ENDPOINT_SOCKET=unix:///run/spire/sockets/agent.sock

# --- Token broker / Vault (never a long-lived secret in clear text) ---
DAYUSE_TOKEN_BROKER_URL=

# --- Business MCP server(s) wired into this agent ---
{{PRIMARY_MCP_ENV}}=

# --- Runtime ---
PORT=8080
# Public URL of the agent (for the Agent Card)
AGENT_PUBLIC_URL=
