# {{AGENT_NAME}} — environment variables. Copy to .env (DO NOT commit the .env).
# No long-lived secret here: references only. Secrets come from the broker/Vault.

# --- Model (LiteLLM; Claude Sonnet 5.5 through OpenRouter by default, not coupled to the cloud) ---
DAYUSE_MODEL=openrouter/anthropic/claude-sonnet-5.5
OPENROUTER_API_KEY=
# Extra OpenRouter routing preferences (JSON object). agent.py forces "zdr": true on top of
# whatever is set here. EU model endpoint (details: scaffold-agent/references/dayuse-defaults.md):
# DAYUSE_OPENROUTER_PROVIDER_PREFS={"order": ["google-vertex/europe"], "allow_fallbacks": false}
# Use the cost map bundled with the installed LiteLLM; without it LiteLLM downloads the map
# at import (and retries when there is no network).
LITELLM_LOCAL_MODEL_COST_MAP=True

# --- Pluggable identity ---
DAYUSE_IDENTITY_PROVIDER=oidc-mtls
DAYUSE_OIDC_ISSUER=
DAYUSE_OIDC_CLIENT_ID=
# spire : SPIFFE_ENDPOINT_SOCKET=unix:///run/spire/sockets/agent.sock

# --- Token broker / Vault (never a long-lived secret in clear text) ---
DAYUSE_TOKEN_BROKER_URL=

# --- Business MCP server(s) wired into this agent ---
{{PRIMARY_MCP_ENV}}=

# --- Runtime ---
PORT=8080
# Public URL of the agent (for the Agent Card)
AGENT_PUBLIC_URL=
